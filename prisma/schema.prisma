// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email        String   @unique
  name      String
  accounts  Account[]
  passwordHash String    @map("password_hash")
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  dailyTopUpUsages  DailyTopUpUsage[]
  settlements        Settlement[]
  settlementParticipants SettlementParticipant[]
  @@map("users")
}

model Account {
  id        String      @id @default(uuid())
  userId    String
  type      AccountType
  balance   BigInt      @default(0)
  status    AccountStatus @default(ACTIVE)
  productType    SavingsProductType?
  targetAmount   BigInt?            @default(0)
  interestRate   Decimal?           @db.Decimal(5, 4)
  lastInterestAt DateTime?
  transactions   Transaction[]
  user      User        @relation(fields: [userId], references: [id])
  sentTransferRequests     TransferRequest[] @relation("SentTransferRequests")
  receivedTransferRequests TransferRequest[] @relation("ReceivedTransferRequests")

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@map("accounts")
}

model DailyTopUpUsage {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  usageDate  DateTime @db.Date @map("usage_date")
  usedAmount BigInt   @default(0) @map("used_amount")

  user       User     @relation(fields: [userId], references: [id])

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, usageDate])

  @@map("daily_top_up_usages")
}

model Transaction {
  id               String          @id @default(uuid())
  accountId        String
 
  type             TransactionType
  amount           BigInt
  balanceAfter     BigInt
  groupId          String?
  counterpartyId   String?
  counterpartyName String?
  createdAt        DateTime        @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([groupId])
  @@map("transactions")
}

enum TransactionType {
  CHARGE       // 외부에서 내 계좌로 충전
  TRANSFER_OUT // 내 계좌 → 다른 계좌로 이체 (출금)
  TRANSFER_IN  // 다른 계좌 → 내 계좌로 이체 (입금)
  WITHDRAW     // 내 계좌 → 외부로 출금
}
enum AccountType {
  MAIN
  SAVINGS
}

enum AccountStatus {
  ACTIVE
  CLOSED
  SUSPENDED
}

enum SavingsProductType {
  FIXED
  FLEXIBLE
}

model Settlement {
  id           String                  @id @default(uuid())
  requesterId  String
  totalAmount  BigInt
  type         SettlementType
  status       SettlementStatus        @default(PENDING)
  participants SettlementParticipant[]

  requester    User                    @relation(fields: [requesterId], references: [id])

  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@map("settlements")
}

model SettlementParticipant {
  id           String            @id @default(uuid())
  settlementId String
  userId       String
  amount       BigInt
  status       ParticipantStatus @default(PENDING)

  settlement   Settlement        @relation(fields: [settlementId], references: [id])
  user         User              @relation(fields: [userId], references: [id])

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([settlementId, userId])
  @@index([settlementId])
  @@index([userId])
  @@map("settlement_participants")
}

enum SettlementType {
  EQUAL
  RANDOM
}

enum SettlementStatus {
  PENDING
  COMPLETED
}

enum ParticipantStatus {
  PENDING
  PAID
}

model TransferRequest {
  id                 String   @id @default(uuid())
  senderAccountId    String
  recipientAccountId String
  amount             BigInt
  status             TransferRequestStatus @default(PENDING)
  expiresAt          DateTime
  remindedAt         DateTime?

  senderAccount      Account @relation("SentTransferRequests", fields: [senderAccountId], references: [id])
  recipientAccount   Account @relation("ReceivedTransferRequests", fields: [recipientAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderAccountId, status])
  @@index([recipientAccountId, status])
  @@index([status, expiresAt])
  @@map("transfer_requests")
}

enum TransferRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}
