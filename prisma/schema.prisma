// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email        String   @unique
  name      String
  accounts  Account[]
  passwordHash String    @map("password_hash")
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  dailyTopUpUsages  DailyTopUpUsage[]
  @@map("users")
}

model Account {
  id        String      @id @default(uuid())
  userId    String
  type      AccountType
  balance   BigInt      @default(0)
  status    AccountStatus @default(ACTIVE)
  transactions Transaction[]
  user      User        @relation(fields: [userId], references: [id])

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@map("accounts")
}

model DailyTopUpUsage {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  usageDate  DateTime @db.Date @map("usage_date")
  usedAmount BigInt   @default(0) @map("used_amount")

  user       User     @relation(fields: [userId], references: [id])

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, usageDate])

  @@map("daily_top_up_usages")
}

model Transaction {
  id               String          @id @default(uuid())
  accountId        String
 
  type             TransactionType
  amount           BigInt
  balanceAfter     BigInt
  groupId          String?
  counterpartyId   String?
  counterpartyName String?
  createdAt        DateTime        @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([groupId])
  @@map("transactions")
}

enum TransactionType {
  CHARGE       // 외부에서 내 계좌로 충전
  TRANSFER_OUT // 내 계좌 → 다른 계좌로 이체 (출금)
  TRANSFER_IN  // 다른 계좌 → 내 계좌로 이체 (입금)
  WITHDRAW     // 내 계좌 → 외부로 출금
}
enum AccountType {
  MAIN
  SAVINGS
}

enum AccountStatus {
  ACTIVE
  CLOSED
  SUSPENDED
}
